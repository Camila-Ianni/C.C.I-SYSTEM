# deploy/.env.example
# Plantilla de variables de entorno de producción para C.C.I. Communities.
# Copiar a deploy/.env y generar secretos reales con: openssl rand -hex 32
# NUNCA subir deploy/.env al repositorio ni usar los valores REPLACE_WITH_* en producción.
#
# Puertos requeridos en Firewall / NAT:
#   - 80/tcp, 443/tcp          (Caddy HTTPS / WSS)
#   - 7881/tcp                 (LiveKit WebRTC TCP fallback)
#   - 50000-50100/udp          (LiveKit WebRTC ICE media)
#   - 3478/udp, 3478/tcp       (coturn STUN/TURN con HMAC-SHA1; TURNS 5349 deshabilitado con no-tls)
#   - 49152-49200/udp          (coturn media relay ports)

CCI_ENV=production
CCI_HOST=0.0.0.0
CCI_PORT=5050
CCI_STRICT_SECRETS=true

# Dominios canónicos unificados (API, LiveKit RTC y TURN)
API_DOMAIN=api.ccisystem.org
RTC_DOMAIN=rtc.ccisystem.org
TURN_DOMAIN=turn.ccisystem.org
ACME_EMAIL=ops@ccisystem.org
CCI_CORS_ORIGINS=https://ccisystem.org,https://api.ccisystem.org

# Clave maestra de firma JWT (mínimo 32 caracteres aleatorios: openssl rand -hex 32)
CCI_SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32

# Credenciales de LiveKit SFU (voz y streaming WebRTC)
LIVEKIT_WS_URL=wss://rtc.ccisystem.org
LIVEKIT_API_KEY=REPLACE_WITH_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_LIVEKIT_API_SECRET_32_CHARS

# Secreto compartido HMAC para servidor TURN/STUN (coturn)
TURN_SECRET=REPLACE_WITH_COTURN_SHARED_SECRET_32_CHARS
