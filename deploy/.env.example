# deploy/.env.example
# Plantilla de variables de entorno para despliegue de C.C.I. Communities.
# Copiar a deploy/.env y generar secretos reales con: openssl rand -hex 32
# NUNCA subir deploy/.env al repositorio.

CCI_ENV=production
CCI_PORT=5050
CCI_STRICT_SECRETS=true
CCI_CORS_ORIGINS=https://ccisystem.org,https://c-c-i-system.onrender.com

# Clave maestra de firma JWT (mínimo 32 caracteres aleatorios)
CCI_SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32

# Credenciales de LiveKit SFU (voz y streaming WebRTC)
LIVEKIT_WS_URL=wss://rtc.ccisystem.org
LIVEKIT_API_KEY=LK_PROD_KEY_REPLACE_ME
LIVEKIT_API_SECRET=REPLACE_WITH_LIVEKIT_API_SECRET_32_CHARS

# Credenciales de servidor TURN/STUN (coturn)
DOMAIN=turn.ccisystem.org
TURN_SECRET=REPLACE_WITH_COTURN_SHARED_SECRET_32_CHARS

# Opcional: Perfil enterprise-cluster (PostgreSQL / Redis / MinIO)
POSTGRES_USER=cci_user
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD
POSTGRES_DB=cci_communities
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
MINIO_ROOT_USER=cci_minio_admin
MINIO_ROOT_PASSWORD=REPLACE_WITH_MINIO_SECRET_KEY
