# deploy/Caddyfile
# Proxy inverso TLS para C.C.I. Communities.
# Dominios canónicos unificados:
#   - API REST + Socket.IO/WebSocket: {$API_DOMAIN:api.ccisystem.org} -> api:5050
#   - LiveKit SFU Signal WebRTC:      {$RTC_DOMAIN:rtc.ccisystem.org} -> livekit:7880

{
    email {$ACME_EMAIL:ops@ccisystem.org}
}

{$API_DOMAIN:api.ccisystem.org} {
    tls {$CADDY_TLS_MODE:ops@ccisystem.org}

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # API REST v1 y endpoints del sistema
    handle /api/* {
        reverse_proxy api:5050 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Transporte en tiempo real Socket.IO y WebSocket (HTTP 101 Upgrade)
    handle /socket.io/* {
        reverse_proxy api:5050 {
            header_up Connection {http.request.header.Connection}
            header_up Upgrade {http.request.header.Upgrade}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /ws/* {
        reverse_proxy api:5050 {
            header_up Connection {http.request.header.Connection}
            header_up Upgrade {http.request.header.Upgrade}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Sonda de salud y ruta raíz
    handle {
        reverse_proxy api:5050 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}

{$RTC_DOMAIN:rtc.ccisystem.org} {
    tls {$CADDY_TLS_MODE:ops@ccisystem.org}

    # Señalización WebRTC hacia LiveKit SFU Server
    reverse_proxy livekit:7880 {
        header_up Connection {http.request.header.Connection}
        header_up Upgrade {http.request.header.Upgrade}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
