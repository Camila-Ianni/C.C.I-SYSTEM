# deploy/Dockerfile.backend
# Imagen de producción endurecida (non-root) para el backend unificado C.C.I. SYSTEM & Communities
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    CCI_ENV=production \
    CCI_HOST=0.0.0.0 \
    CCI_PORT=5050 \
    CCI_DATABASE_PATH=/data/cci_system.sqlite3 \
    CCI_COMMUNITIES_DB_PATH=/data/cci_communities.sqlite3 \
    CCI_SOUNDS_STORAGE_PATH=/data/sounds \
    CCI_RECORDINGS_PATH=/data/recordings

WORKDIR /app

# Crear usuario sin privilegios y directorios persistentes
RUN groupadd --gid 10001 cciuser \
    && useradd --uid 10001 --gid cciuser --shell /sbin/nologin --create-home cciuser \
    && mkdir -p /data/sounds /data/recordings /app/.cci-user-data \
    && chown -R cciuser:cciuser /data /app

# Instalar dependencias del servidor
COPY requirements-server.txt /app/requirements-server.txt
RUN pip install --upgrade pip && pip install -r /app/requirements-server.txt

# Copiar código del servidor y módulos compartidos
COPY --chown=cciuser:cciuser backend /app/backend
COPY --chown=cciuser:cciuser recorder /app/recorder
COPY --chown=cciuser:cciuser cci_database.py catalog_data.py version.json /app/

USER cciuser

EXPOSE 5050

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request, sys; r = urllib.request.urlopen('http://127.0.0.1:5050/api/v1/communities/health', timeout=4); sys.exit(0 if r.status == 200 else 1)"

CMD ["python", "-m", "backend.server"]
