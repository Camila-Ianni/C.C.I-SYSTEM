# ==============================================================================
# C.C.I. SYSTEM — CONFIGURACIÓN DE ENTORNO
# ==============================================================================

# Entorno y Servidor Web / WebSocket
CCI_ENV=development
CCI_HOST=0.0.0.0
CCI_PORT=5050
CCI_DEBUG=false
CCI_SECRET_KEY=cci-secret-key-change-in-production
CCI_CORS_ORIGINS=*

# Persistencia Relacional
CCI_DATABASE_PATH=.cci-user-data/cci_system.sqlite3

# Señalización WebRTC y Servidores STUN / TURN
CCI_STUN_SERVER=stun:stun.l.google.com:19302
CCI_TURN_SERVER=
CCI_TURN_USERNAME=
CCI_TURN_CREDENTIAL=

# Galería de Grabaciones de Gameplay
CCI_RECORDINGS_PATH=grabaciones
CCI_MAX_RECORDINGS_STORAGE_MB=2048
